ENVIRONMENT=local

DB_USER=root
DB_PASSWORD=password
DB_NAME=fasti_kit

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/fasti_kit
DATABASE_REPLICA_URL=postgresql+asyncpg://postgres:postgres@localhost:5434/fasti_kit

# DATABASE POOL SETTINGS
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=False

BACKEND_URL="http://localhost:8000"

ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
# jwt cookies secure is HTTPS only (set false for local environment)
JWT_COOKIE_SECURE=False

# Mail (SMTP) — MailHog local dev catcher, no auth. UI at http://localhost:8025
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Fasti Kit
MAIL_PORT=1025
MAIL_SERVER=localhost
MAIL_STARTTLS=False
MAIL_SSL_TLS=False

# REDIS
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Seconds to wait for in-flight requests on shutdown before force-cancelling
SHUTDOWN_TIMEOUT=30

OUTBOX_POLL_INTERVAL=5.0
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETENTION_DAYS=7
